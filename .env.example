# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_case_sim"

# API Server Port
PORT=5000

# Number of reverse proxies in front of the API (or a subnet). Leave unset when
# nothing proxies it. Without this, every request behind a proxy shares one
# apparent IP and the per-IP login rate limits stop distinguishing callers; with
# it set when nothing sets X-Forwarded-For, a caller can forge their own address.
# TRUST_PROXY=1

# Local web app configuration
API_PORT=5000
BASE_PATH="/"

# OpenAI API Key (Required for AI case generation & judge turns)
OPENAI_API_KEY=""

# Signs the session cookie. At least 32 characters, and required before anyone
# can sign in - there is deliberately no default, because a generated fallback
# would log everyone out on every restart and a hardcoded one would make every
# deployment forgeable. Rotating this is also the only way to revoke all
# sessions at once. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Python AI service (retrieval, grounding, memory, agents)
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_TIMEOUT_MS=60000

# Reranking backend: llm | cross_encoder | none
# Defaults to llm on measured evidence - see artifacts/ai-service/docs/retrieval.md
RERANKER_BACKEND="llm"
